# Copy this to .env and fill in your own values. Never commit .env.
#
# JWT_SECRET / AI_KEY_ENCRYPTION_SECRET: any long random string, e.g.
#   openssl rand -hex 32
JWT_SECRET=
AI_KEY_ENCRYPTION_SECRET=

# Web Push (optional -- needed only for reminder notifications). Generate with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
